# Local secrets and editor state.
.env
.env.*
!.env.example
.DS_Store
node_modules/
coverage/
projects.local.yaml

# Local child repositories stay visible under the HQ tree, but never become HQ content.
/checkouts/*
!/checkouts/.gitkeep
!/checkouts/README.md
.assets

# Output that a child project, test runner or build tool writes into whatever folder it is run
# from. HQ tracks none of these; anchored to the root so nothing under memory/, test/ or docs/
# can be hidden by accident. (2026-10-04: a child test run from here wrote data/*.sqlite.)
/data/
/imports/
/.local/
/tmp/
/temp/
/dist/
/build/
/out/
/target/
/.next/
/.turbo/
/.vercel/
/.cache/
/test-results/
/playwright-report/
/blob-report/
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.log
